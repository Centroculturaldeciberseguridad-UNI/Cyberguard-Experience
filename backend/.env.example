# Copiar este archivo como ".env" y ajustar valores segun el entorno

# Nombre del proyecto (aparece en el título de la API)
PROJECT_NAME=CyberGuard_Experience

# URL de la base de datos (SQLite para desarrollo)
DATABASE_URL=sqlite:///./database/ciberseguridad.db

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173